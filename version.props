<Project>
	<PropertyGroup>
		<Version>1.0.0</Version>
		<Authors>ketpsi-net</Authors>
		<Company>ketpsi-net</Company>
		<AssemblyName>$(AssemblyName)</AssemblyName>
		<PackageId>$(AssemblyName)</PackageId>
		<RepositoryUrl>https://github.com/ketpsi-net/KetPsi.Mediator</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ketpsi-net/KetPsi.Mediator</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<Icon>icon.png</Icon>
		<Copyright>Copyright © 2027</Copyright>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.MD">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
