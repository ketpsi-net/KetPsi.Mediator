<Project>
	<PropertyGroup>
		<Version>1.0.0</Version>
		<Authors>ketpsi-net</Authors>
		<Company>ketpsi-net</Company>
		<AssemblyName>$(AssemblyName)</AssemblyName>
		<PackageId>$(AssemblyName)</PackageId>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) 2026 ketpsi-net</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/ketpsi-net/KetPsi.Mediator</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ketpsi-net/KetPsi.Mediator</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.MD">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
